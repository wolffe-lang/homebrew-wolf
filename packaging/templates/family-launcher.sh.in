#!/bin/sh
set -eu
bin_dir=@@BIN_DIRECTORY@@
case "${1-}" in
    --version)
        printf '%s\n' '@@DISPATCHER@@ (@@NAME@@) @@VERSION@@'
        exit 0
        ;;
    ''|--help)
        printf '%s\n' 'Usage: @@DISPATCHER@@ UTILITY [ARGUMENT...]' 'Run an installed @@NAME@@ utility without changing system command names.'
        exit 0
        ;;
esac
utility=$1
shift
case "$utility" in
    ''|.|..|*/*)
        printf '%s\n' '@@DISPATCHER@@: utility must be a single installed name' >&2
        exit 64
        ;;
esac
if [ ! -f "$bin_dir/$utility" ] || [ ! -x "$bin_dir/$utility" ]; then
    printf '%s\n' "@@DISPATCHER@@: unknown utility: $utility" >&2
    exit 127
fi
exec "$bin_dir/$utility" "$@"

require "shellwords"

class @@CLASS@@ < Formula
  desc "@@DESC@@"
  homepage "https://github.com/wolffe-lang/@@NAME@@"
  license "@@LICENSE@@"
  version "@@VERSION@@"

  # Prebuilt from the exact compiler/runtime pins, not the moving wolf formula.
  on_macos do
    on_arm do
      url "https://github.com/wolffe-lang/@@NAME@@/releases/download/v@@VERSION@@/@@NAME@@-@@VERSION@@-aarch64-apple-darwin.tar.gz"
      sha256 "@@MAC_SHA256@@"
    end
  end
  on_linux do
    on_intel do
      url "https://github.com/wolffe-lang/@@NAME@@/releases/download/v@@VERSION@@/@@NAME@@-@@VERSION@@-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "@@LINUX_SHA256@@"
    end
  end

  def install
    (libexec/"boreutils/bin").install @@BREW_BINARIES@@
    launcher = <<~'BORE_LAUNCHER'
@@BREW_LAUNCHER@@    BORE_LAUNCHER
    bin.mkpath
    (bin/"bore").write launcher.sub("__BORE_BIN_DIR__", (opt_libexec/"boreutils/bin").to_s.shellescape)
    (bin/"bore").chmod 0755
    doc.install "BUILD.json", "README.md", "CHANGELOG.md", "wolf-toolchain.toml"
  end

  def caveats
    <<~EOS
      Only bore is installed on PATH. For unprefixed utility names, opt in:
        export PATH="#{opt_libexec}/boreutils/bin:$PATH"
      Or create selected links in your own bin directory; no system tools are replaced.
    EOS
  end

  test do
    assert_match "bore (boreutils) #{version}", shell_output("#{bin}/bore --version")
    assert_equal "dispatcher works", shell_output("#{bin}/bore printf 'dispatcher works'")
  end
end

#!/usr/bin/env python3
"""Generate prebuilt Homebrew/AUR recipes; --check is a byte-for-byte dry run."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import sys
import tempfile
import urllib.request

ROOT = Path(__file__).resolve().parents[1]
SEMVER = r'(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)'
HOSTS = {'MAC_SHA256': 'aarch64-apple-darwin', 'LINUX_SHA256': 'x86_64-unknown-linux-gnu'}


def fail(message):
    raise ValueError('FAIL packaging: ' + message)


def fetch(url):
    # Published recipes must be independently obtainable without credentials.
    request = urllib.request.Request(url, headers={'User-Agent': 'package-bin'})
    with urllib.request.urlopen(request, timeout=120) as response:
        return response.read()


def verified_digests(name, version, folder):
    repo = 'wolffe-lang/' + name
    release = json.loads(fetch(f'https://api.github.com/repos/{repo}/releases/tags/v{version}'))
    if release.get('draft') is not False or release.get('tag_name') != 'v' + version:
        fail('expected a published release at the requested tag')
    result = {}
    for key, host in HOSTS.items():
        archive = f'{name}-{version}-{host}.tar.gz'
        matches = [a for a in release['assets'] if a['name'] == archive]
        if len(matches) != 1:
            fail('missing or duplicated archive: ' + archive)
        base = f'https://github.com/{repo}/releases/download/v{version}/'
        content = fetch(base + archive)
        # Retain downloaded data only inside this new empty download directory.
        (folder / archive).write_bytes(content)
        digest = hashlib.sha256(content).hexdigest()
        sidecar = fetch(base + archive + '.sha256').decode('ascii').split()
        if sidecar != [digest, archive] or matches[0].get('digest') != 'sha256:' + digest:
            fail('sidecar, API and anonymous archive hash disagree: ' + archive)
        result[key] = digest
        print(f'PASS packaging-digest {archive} sha256={digest} sidecar=API=download')
    return result


def render(template, values):
    for key, value in values.items():
        template = template.replace('@@' + key + '@@', value)
    if re.search(r'@@[A-Z_]+@@', template):
        fail('unfilled template variable')
    return template


def generate(product, version, digests):
    config_path = ROOT / 'packaging/products' / (product + '.json')
    config = json.loads(config_path.read_text())
    if config['name'] != product:
        fail('product configuration name mismatch')
    values = dict(config, VERSION=version, **digests)
    values['CLASS'] = config.get('class', ''.join(p.capitalize() for p in product.split('-')))
    values['NAME'] = product
    values['DESC'] = config['description']
    values['LICENSE'] = config['license']
    binaries = config['binaries']
    if not binaries or not all(re.fullmatch(r'[A-Za-z0-9_.+-]+', b) for b in binaries):
        fail('invalid installed binary name')
    values['BREW_BINARIES'] = ', '.join(json.dumps(b) for b in binaries)
    values['AUR_BINARIES'] = '\n'.join(f'    install -Dm755 {b} "$pkgdir/usr/bin/{b}"' for b in binaries)
    values['VERSION_COMMAND'] = config['version_command']
    if any("'" in config[k] or '\n' in config[k] or '"' in config[k] for k in ('description', 'license', 'version_command')):
        fail('metadata contains recipe quoting characters')
    hooks = config.get('hooks', {})
    outputs = {}
    for kind, destination, default in (
        ('formula', f'Formula/{product}.rb', 'formula.rb.in'),
        ('pkgbuild', f'aur/{product}-bin/PKGBUILD', 'PKGBUILD.in'),
        ('srcinfo', f'aur/{product}-bin/.SRCINFO', 'SRCINFO.in'),
        ('install', f'aur/{product}-bin/{product}-bin.install', None),
    ):
        source = hooks.get(kind)
        if source:
            path = (ROOT / 'packaging' / source).resolve()
            if not path.is_relative_to((ROOT / 'packaging').resolve()):
                fail('hook path escapes packaging/')
        elif default:
            path = ROOT / 'packaging/templates' / default
        else:
            continue
        outputs[destination] = render(path.read_text(), values).encode()
    return outputs


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('--product', required=True)
    p.add_argument('--version', required=True)
    p.add_argument('--check', action='store_true', help='compare every generated byte without rewriting')
    p.add_argument('--output', type=Path, help='write only under this explicitly chosen directory')
    p.add_argument('--offline', action='store_true', help='test fixtures only; do not verify release bytes')
    p.add_argument('--mac-sha256')
    p.add_argument('--linux-sha256')
    a = p.parse_args()
    if not re.fullmatch(r'[a-z][a-z0-9-]*', a.product) or not re.fullmatch(SEMVER, a.version):
        fail('invalid product name or stable semantic version')
    if a.check == bool(a.output):
        fail('choose exactly one of --check and --output')
    if a.offline:
        digests = dict(MAC_SHA256=a.mac_sha256 or '', LINUX_SHA256=a.linux_sha256 or '')
        print('OFFLINE fixture mode: published archive integrity was NOT checked')
    else:
        if a.mac_sha256 or a.linux_sha256:
            fail('explicit digests require --offline')
        (ROOT / 'target').mkdir(exist_ok=True)
        with tempfile.TemporaryDirectory(prefix='package-download-', dir=ROOT / 'target') as tmp:
            digests = verified_digests(a.product, a.version, Path(tmp))
    if not all(re.fullmatch(r'[0-9a-f]{64}', d) and d != '0' * 64 for d in digests.values()):
        fail('both digests must be non-placeholder lowercase SHA-256 values')
    if len(set(digests.values())) != 2:
        fail('platform digests must differ')
    outputs = generate(a.product, a.version, digests)
    for path, content in outputs.items():
        if a.check:
            actual = ROOT / path
            if not actual.exists() or actual.read_bytes() != content:
                fail('byte mismatch: ' + path)
            print(f'PASS packaging-byte-identity {path} bytes={len(content)} sha256={hashlib.sha256(content).hexdigest()}')
        else:
            dest = a.output / path
            dest.parent.mkdir(parents=True, exist_ok=True)
            dest.write_bytes(content)
            print(f'GENERATED {path} bytes={len(content)}')


if __name__ == '__main__':
    try:
        main()
    except (ValueError, OSError, KeyError) as error:
        print(error, file=sys.stderr)
        sys.exit(1)
